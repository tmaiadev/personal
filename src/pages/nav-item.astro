---
const { href } = Astro.props;
---

<li>
  <a
    href={href}
    class="block rounded-full border border-transparent px-3 py-2 text-sm transition-all hover:bg-[rgba(0,0,0,.05)] hover:inset-shadow-2xs focus:bg-[rgba(0,0,0,.05)] focus:inset-shadow-2xs active:bg-[rgba(0,0,0,.05)] active:inset-shadow-2xs"
  >
    <slot />
  </a>
</li>
