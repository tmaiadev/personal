---
import '../styles/global.css';
import { site } from '../data/site';

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  image: new URL('/hero.jpg', site.url).href,
  sameAs: [
    'https://github.com/tmaiadev',
    'https://www.linkedin.com/in/thallesmaia',
    'https://www.instagram.com/tmaiadev',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} — {site.role}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1d1b" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${site.name} — ${site.role}`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${site.name} — ${site.role}`} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <slot />

    <script>
      import '../scripts/scroll-reveal';
      import '../scripts/durations';
      import '../scripts/contact-reveal';
    </script>

    <script
      is:inline
      defer
      src="https://analytics.thallesmaia.com/script.js"
      integrity="sha384-a6uZVLGyB3/jypEUOZoga400ckRvQpsCdLGYzuUjytPjb8QayrBLhdGBLTuijfWh"
      crossorigin="anonymous"></script>
  </body>
</html>
