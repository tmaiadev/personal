---
import { site } from '../data/site';
import { socials } from '../data/contact';
---

<header class="reveal flex flex-col items-start gap-8 sm:flex-row sm:items-center">
  <img
    src="/hero.jpg"
    alt={`Portrait of ${site.name}`}
    width="112"
    height="112"
    loading="eager"
    decoding="async"
    class="h-24 w-24 shrink-0 rounded-full object-cover shadow-sm ring-1 ring-line sm:h-28 sm:w-28"
  />

  <div class="flex flex-col gap-3">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{site.name}</h1>
      <p class="mt-1 text-lg text-accent">{site.role}</p>
    </div>

    <p class="max-w-prose text-muted">{site.intro}</p>

    <nav aria-label="Social links" class="mt-1 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {
        socials.map((s) => (
          <a href={s.url} target="_blank" rel="me noopener" class="hover:text-accent">
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
