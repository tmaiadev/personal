---
import { projects } from '../data/projects';
---

<section aria-labelledby="projects-heading" class="reveal">
  <h2 id="projects-heading" class="text-sm font-semibold tracking-widest text-muted uppercase">
    Projects
  </h2>

  <ul class="mt-6 flex flex-col divide-y divide-line">
    {
      projects.map((project) => (
        <li class="py-5">
          <h3 class="text-lg font-medium">
            <a
              href={project.url}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-baseline gap-1.5 hover:text-accent"
            >
              {project.name}
              <span aria-hidden="true" class="text-accent-soft transition-transform group-hover:translate-x-0.5">
                ↗
              </span>
            </a>
          </h3>
          <p class="mt-1 max-w-prose text-muted">{project.description}</p>
        </li>
      ))
    }
  </ul>
</section>
